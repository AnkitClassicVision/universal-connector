<?xml version="1.0" encoding="UTF-8"?>
<!-- A Task Scheduler logon task for the door. Render it for this machine with
     uconnector install-service and its print flag. Every path is absolute. The command only
     prints; registering the task is yours. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>universal connector door, loopback only</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>{{USER_ID}}</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{{USER_ID}}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{INSTALL_DIR}}\uconnector.exe</Command>
      <Arguments>serve --machine-file "{{MACHINE_FILE}}" --manifest "{{MANIFEST_DIR}}" --state "{{STATE_DIR}}" --host 127.0.0.1 --port 8765</Arguments>
      <WorkingDirectory>{{MANIFEST_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
